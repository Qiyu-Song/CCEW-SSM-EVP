#!/bin/bash
#SBATCH -J spmd_testbc
#SBATCH -o out-spmd-testbc
#SBATCH -e eo-spmd-testbc
#SBATCH -n 1
#SBATCH -c 41
#SBATCH -t 0-12:00
#SBATCH -p huce_bigmem
#SBATCH --mem 1500000
